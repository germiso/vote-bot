import asyncio
import os
import sqlite3
from dotenv import load_dotenv
from aiogram import Bot, Dispatcher, F, types
from aiogram.types import InlineKeyboardButton, InlineKeyboardMarkup, InputMediaPhoto
from aiogram.filters import CommandStart

load_dotenv()
TOKEN = os.getenv("BOT_TOKEN")
ADMIN_ID = int(os.getenv("ADMIN_ID"))

participants = [
    {"id": 101, "name": "Участник А", "photo": "https://picsum.photos/seed/a/600/400"},
    {"id": 102, "name": "Участник Б", "photo": "https://picsum.photos/seed/b/600/400"},
    {"id": 103, "name": "Участник В", "photo": "https://picsum.photos/seed/c/600/400"},
]

def init_db():
    conn = sqlite3.connect("votes.db")
    c = conn.cursor()
    c.execute("""
        CREATE TABLE IF NOT EXISTS votes (
            user_id INTEGER,
            participant_id INTEGER,
            nomination_id INTEGER DEFAULT 1,
            UNIQUE(user_id, nomination_id)
        )
    """)
    conn.commit()
    return conn

conn = init_db()

def get_vote_keyboard(index: int):
    prev_idx = (index - 1) % len(participants)
    next_idx = (index + 1) % len(participants)
    buttons = [
        [
            InlineKeyboardButton(text="⬅️", callback_data=f"nav:{prev_idx}"),
            InlineKeyboardButton(text="Голосовать", callback_data=f"ask_vote:{participants[index]['id']}"),
            InlineKeyboardButton(text="➡️", callback_data=f"nav:{next_idx}"),
        ]
    ]
    return InlineKeyboardMarkup(inline_keyboard=buttons)

bot = Bot(token=TOKEN)
dp = Dispatcher()

@dp.message(CommandStart())
async def cmd_start(message: types.Message):
    idx = 0
    person = participants[idx]
    await message.answer_photo(
        photo=person["photo"],
        caption=f"**{person['name']}**\n\nПроголосуйте за него.",
        reply_markup=get_vote_keyboard(idx),
        parse_mode="Markdown",
    )

@dp.callback_query(F.data.startswith("nav:"))
async def handle_nav(callback: types.CallbackQuery):
    idx = int(callback.data.split(":")[1])
    person = participants[idx]
    media = InputMediaPhoto(
        media=person["photo"],
        caption=f"**{person['name']}**\n\nПроголосуйте за него.",
    )
    await callback.message.edit_media(media, reply_markup=get_vote_keyboard(idx))
    await callback.answer()

@dp.callback_query(F.data.startswith("ask_vote:"))
async def ask_vote(callback: types.CallbackQuery):
    pid = int(callback.data.split(":")[1])
    person = next(p for p in participants if p["id"] == pid)
    keyboard = InlineKeyboardMarkup(inline_keyboard=[
        [
            InlineKeyboardButton(text="✅ Да, голосую", callback_data=f"confirm_vote:{pid}"),
            InlineKeyboardButton(text="❌ Отмена", callback_data="cancel_vote"),
        ]
    ])
    await callback.message.answer(
        f"Вы точно хотите проголосовать за **{person['name']}**?",
        reply_markup=keyboard,
        parse_mode="Markdown",
    )
    await callback.answer()

@dp.callback_query(F.data.startswith("confirm_vote:"))
async def confirm_vote(callback: types.CallbackQuery):
    uid = callback.from_user.id
    pid = int(callback.data.split(":")[1])
    try:
        conn.execute(
            "INSERT INTO votes (user_id, participant_id) VALUES (?, ?)",
            (uid, pid),
        )
        conn.commit()
        await callback.answer("Ваш голос принят! ✅", show_alert=False)
    except sqlite3.IntegrityError:
        await callback.answer("Вы уже голосовали!", show_alert=True)
    await callback.message.delete()

@dp.callback_query(F.data == "cancel_vote")
async def cancel_vote(callback: types.CallbackQuery):
    await callback.answer("Отменено")
    await callback.message.delete()

@dp.message(F.text == "/stats")
async def stats(message: types.Message):
    if message.from_user.id != ADMIN_ID:
        await message.answer("Нет доступа.")
        return
    c = conn.cursor()
    c.execute("""
        SELECT p.name, COUNT(v.user_id)
        FROM participants p
        LEFT JOIN votes v ON p.id = v.participant_id
        GROUP BY p.id
    """)
    rows = c.fetchall()
    text = "📊 **Статистика голосования**\n\n" + "\n".join(
        f"{name}: {cnt} голосов" for name, cnt in rows
    )
    await message.answer(text, parse_mode="Markdown")

async def main():
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
